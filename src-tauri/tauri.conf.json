{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koffice",
  "version": "0.4.0-alpha.1",
  "identifier": "dev.kodi.koffice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Koffice \u2014 Writer \u00b7 Sheets \u00b7 Slides \u00b7 Base",
        "width": 1260,
        "height": 820,
        "minWidth": 780,
        "minHeight": 540,
        "backgroundColor": "#111317"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}